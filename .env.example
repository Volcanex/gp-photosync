# Copy to .env.r2 (the systemd units load it as EnvironmentFile).
R2_ACCOUNT_ID=
R2_BUCKET=
# Optional: defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_PREFIX=photos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=
# The API has no auth of its own, so it stays on loopback behind an authenticating proxy.
HOST=127.0.0.1
PORT=5656
# Deletes and POST /derive/backfill need this in an X-Delete-Token header, and are refused while it is unset.
PHOTO_DELETE_TOKEN=
# Optional: POST here (X-Admin-Password: BLOG_REBUILD_TOKEN) after uploads so a site can rebuild its manifest.
BLOG_REBUILD_URL=
BLOG_REBUILD_TOKEN=
# Optional: g-brain checkout whose brain_alerts module reconcile.py reports drift to.
BRAIN_TOOLS_DIR=
